// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id String @id @default(uuid())
  email String @unique
  passwordHash String @map("password_hash")
  tfaSecret String? @map("tfa_secret")
  tfaEnabled Boolean @map("tfa_enabled") @default(false)
  backupCodes String[] @map("backup_codes")
  tokenId String? @map("token_id")
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt
}

model SiteConfigs{
  id String @id @default(uuid())
  name String @default("Bikram Nepali")
  profileImageUrl String? @map("profile_image_url")
  quote String?
  bioParagraphs String[] @map("bio_paragraphs")

  // Highlight blocks
  philosophyTitle String?  @map("philosophy_title")
  philosophyText  String?  @map("philosophy_text")
  inspirationTitle String? @map("inspiration_title")
  inspirationText String?  @map("inspiration_text")
  approachTitle   String?  @map("approach_title")
  approachText    String?  @map("approach_text")
  location        String
  map_url String? @map("map_url")

  // Contact Info
  email           String
  phone           String
  responseTimeMessage    String   @map("response_time_message")

  // Social Links
  instagramUrl    String?  @map("instagram_url")
  facebookUrl     String?  @map("facebook_url")
  twitterUrl      String?  @map("twitter_url")
  linkedinUrl     String?  @map("linkedin_url")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("site_configs")

}