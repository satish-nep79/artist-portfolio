{% extends "layouts/base.njk" %}

{% from "components/admin-header.njk" import adminHeader %}
{% from "components/admin-sidebar.njk" import adminSidebar %}

{% block title %}{{ title | default("Admin Panel") }}{% endblock %}

{% block body_class %}dashboard-page{% endblock %}

{% block head %}
{% endblock %}

{% block body %}
<div class="dashboard-layout">
    {# Render Sidebar with active page context #}
    {{ adminSidebar(activePage=activePage | default('dashboard')) }}

    <div class="page-wrapper">
        {# Render Header #}
        {{ adminHeader(username="Sarah Johnson") }}

        <!-- Main Content Area -->
        <main class="page-body">
            <div class="container-xl">
                {% block page_header %}{% endblock %}
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
</div>
{% endblock %}