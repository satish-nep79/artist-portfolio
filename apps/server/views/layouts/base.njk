<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %} Admin {% endblock %}</title>

    <!-- Core Scripts & Styles -->
    <script src="/admin/shared/js/tabler-config.js" defer></script>
    <link rel="stylesheet" href="/admin/shared/css/admin.css?v={{ assetVersion | default('20260906-5') }}">
    <script src="/admin/shared/components/admin-header.js" defer></script>

    {% block meta %}
    {% endblock %}

    {% block styles %}
    {% endblock %}

    {% block head %}
    {% endblock %}
</head>

<body class="admin-shell {% block body_class %}{% endblock %}">

    {% block body %}
    {% endblock %}

</body>

</html>