{% macro cropModal(params = {}) %}
  {% set modalId = params.modalId | default("cropModal") %}
  {% set cropImageId = params.cropImageId | default("imageToCrop") %}
  {% set applyBtnId = params.applyBtnId | default("applyCropBtn") %}
  {% set title = params.title | default("Adjust & Crop Image") %}
  {% set applyText = params.applyText | default("Crop & Save") %}
  {% set cancelText = params.cancelText | default("Cancel") %}

  <div class="modal fade" id="{{ modalId }}" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">{{ title }}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-0">
          <div style="max-height: 450px; overflow: hidden;">
            <img id="{{ cropImageId }}" src="" alt="Crop target" style="max-width: 100%;">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">{{ cancelText }}</button>
          <button type="button" class="btn btn-primary ms-auto" id="{{ applyBtnId }}">{{ applyText }}</button>
        </div>
      </div>
    </div>
  </div>
{% endmacro %}